{
    "name": "@megbailey/ui",
    "version": "1.1.0",
    "description": "React component library with W3 design patterns, new form elements, GraphQL integrations, and hooks.",
    "license": "MIT",
    "author": "Megan Bailey",
    "repository": {
        "type": "git",
        "url": "https://github.com/megbailey/megbailey-core.git",
        "directory": "packages/ui"
    },
    "bugs": {
        "url": "https://github.com/megbailey/megbailey-core/issues"
    },
    "homepage": "https://github.com/megbailey/megbailey-core/tree/main/packages/ui#readme",
    "keywords": [
        "react",
        "components",
        "ui",
        "form-elements",
        "design-system"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./button": {
            "types": "./dist/components/button/Button.d.ts",
            "import": "./dist/components/button/Button.js",
            "default": "./dist/components/button/Button.js"
        },
        "./icon": {
            "types": "./dist/components/icon/Icon.d.ts",
            "import": "./dist/components/icon/Icon.js",
            "default": "./dist/components/icon/Icon.js"
        },
        "./tooltip": {
            "types": "./dist/components/tooltip/Tooltip.d.ts",
            "import": "./dist/components/tooltip/Tooltip.js",
            "default": "./dist/components/tooltip/Tooltip.js"
        },
        "./paragraph": {
            "types": "./dist/components/text/Paragraph.d.ts",
            "import": "./dist/components/text/Paragraph.js",
            "default": "./dist/components/text/Paragraph.js"
        },
        "./disclosure-tree": {
            "types": "./dist/components/disclosure-tree/DisclosureTree.d.ts",
            "import": "./dist/components/disclosure-tree/DisclosureTree.js",
            "default": "./dist/components/disclosure-tree/DisclosureTree.js"
        },
        "./expansion-controls": {
            "types": "./dist/components/disclosure-tree/ExpansionControls.d.ts",
            "import": "./dist/components/disclosure-tree/ExpansionControls.js",
            "default": "./dist/components/disclosure-tree/ExpansionControls.js"
        },
        "./button-select": {
            "types": "./dist/components/form-elements/button-select/ButtonSelect.d.ts",
            "import": "./dist/components/form-elements/button-select/ButtonSelect.js",
            "default": "./dist/components/form-elements/button-select/ButtonSelect.js"
        },
        "./dropzone": {
            "types": "./dist/components/form-elements/dropzone/Dropzone.d.ts",
            "import": "./dist/components/form-elements/dropzone/Dropzone.js",
            "default": "./dist/components/form-elements/dropzone/Dropzone.js"
        },
        "./graphql-select": {
            "types": "./dist/components/form-elements/graphql-select/GraphQLSelect.d.ts",
            "import": "./dist/components/form-elements/graphql-select/GraphQLSelect.js",
            "default": "./dist/components/form-elements/graphql-select/GraphQLSelect.js"
        },
        "./informed-select": {
            "types": "./dist/components/form-elements/informed-select/InformedSelect.d.ts",
            "import": "./dist/components/form-elements/informed-select/InformedSelect.js",
            "default": "./dist/components/form-elements/informed-select/InformedSelect.js"
        },
        "./toggle-switch": {
            "types": "./dist/components/form-elements/toggle-switch/ToggleSwitch.d.ts",
            "import": "./dist/components/form-elements/toggle-switch/ToggleSwitch.js",
            "default": "./dist/components/form-elements/toggle-switch/ToggleSwitch.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.lib.json",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:changed": "vitest run --changed",
        "test:storybook": "vitest run --config vitest.storybook.config.ts",
        "test:all": "vitest run && vitest run --config vitest.storybook.config.ts",
        "storybook": "lsof -t -i:6006 | grep . && kill -9 $(lsof -t -i:6006); storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@megbailey/utils": "1.1.0",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.17",
        "graphql-tag": "^2.12.6",
        "uniqid": "^5.4.0"
    },
    "peerDependencies": {
        "@apollo/client": "^3.13.0",
        "informed": "^4.66.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "react-select": "^5.10.0"
    },
    "peerDependenciesMeta": {
        "@apollo/client": {
            "optional": true
        },
        "informed": {
            "optional": true
        },
        "react-select": {
            "optional": true
        }
    },
    "devDependencies": {
        "@apollo/client": "^3.13.1",
        "@chromatic-com/storybook": "^5.2.1",
        "@storybook/addon-a11y": "^10.4.6",
        "@storybook/addon-docs": "^10.4.6",
        "@storybook/addon-mcp": "^0.6.0",
        "@storybook/addon-vitest": "^10.4.6",
        "@storybook/react-vite": "^10.4.6",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/uniqid": "^5.3.4",
        "@vitejs/plugin-react": "^5.0.4",
        "@vitest/browser-playwright": "^4.1.9",
        "@vitest/coverage-v8": "^4.1.9",
        "informed": "^4.66.3",
        "jsdom": "^27.0.0",
        "playwright": "^1.61.1",
        "prettier": "^3.6.2",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-select": "^5.10.2",
        "storybook": "^10.4.6",
        "typescript": "^5.7.3",
        "vite": "^7.1.9",
        "vitest": "^4.1.9"
    },
    "engines": {
        "node": ">=18"
    }
}
