{
    "name": "@megbailey/utils",
    "version": "1.0.3",
    "description": "Shared utility helpers for megbailey projects.",
    "license": "MIT",
    "author": "Megan Bailey",
    "repository": {
        "type": "git",
        "url": "https://github.com/megbailey/megbailey-core.git",
        "directory": "packages/utils"
    },
    "bugs": {
        "url": "https://github.com/megbailey/megbailey-core/issues"
    },
    "homepage": "https://github.com/megbailey/megbailey-core/tree/main/packages/utils#readme",
    "keywords": [
        "utils",
        "helpers",
        "traversal"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run build"
    },
    "engines": {
        "node": ">=18"
    }
}
